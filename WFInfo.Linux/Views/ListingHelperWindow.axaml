<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WFInfo.Linux.Views.ListingHelperWindow"
        Title="Auto List" Width="400"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        Background="#FF1B1B1B">

    <Window.Styles>
        <Style Selector="RepeatButton.spin">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="SpinBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Padding="0" Margin="0" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RepeatButton.spin:pointerover /template/ Border#SpinBorder">
            <Setter Property="Background" Value="#FF4A4A4A" />
        </Style>
        <Style Selector="RepeatButton.spin:pressed /template/ Border#SpinBorder">
            <Setter Property="Background" Value="#FF606060" />
        </Style>
    </Window.Styles>

    <Border BorderBrush="#FF707070" BorderThickness="1">
    <Grid RowDefinitions="23,Auto,Auto,Auto,Auto,Auto,Auto" PointerPressed="OnPointerPressed">
        <!-- Title bar -->
        <Grid Grid.Row="0">
            <Rectangle Fill="#FF0F0F0F" />
            <Image Margin="2,0,0,0" Source="avares://WFInfo.Linux/Resources/WFLogo.png"
                   Height="20" VerticalAlignment="Center" HorizontalAlignment="Left" Width="18" />
            <TextBlock Text="Auto List" Margin="24,1,0,0" FontSize="14" FontWeight="Bold"
                       FontFamily="{StaticResource RobotoBlack}"
                       VerticalAlignment="Center" />
            <Rectangle Fill="#FF646464" Width="1" Margin="0,0,43,0" Height="22" VerticalAlignment="Top" HorizontalAlignment="Right" />
            <Button Content="_" Click="Minimize_Click" Classes="linkButton"
                    Height="22" HorizontalAlignment="Right" Width="22"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,21,0" />
            <Rectangle Fill="#FF646464" Width="1" Margin="0,0,21,0" Height="22" VerticalAlignment="Top" HorizontalAlignment="Right" />
            <Button Content="x" Click="Close_Click" Classes="linkButton"
                    Height="22" HorizontalAlignment="Right" Width="22"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
            <Rectangle Height="1" Fill="#FF646464" VerticalAlignment="Bottom" />
        </Grid>

        <!-- Reward selection -->
        <Grid Grid.Row="1" Margin="10,6,10,0" ColumnDefinitions="*,Auto">
            <ComboBox x:Name="RewardCombo" HorizontalAlignment="Stretch"
                      Background="#FF333333" Foreground="#FFB1D0D9"
                      SelectionChanged="RewardCombo_Changed" />
            <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center"
                       Margin="8,0,0,0" FontSize="11" Foreground="#FF888888" />
        </Grid>

        <!-- Top 5 sell orders header -->
        <TextBlock x:Name="TopOrdersLabel" Grid.Row="2" Text="Top 5 sell orders" Foreground="#FFB1D0D9"
                   FontWeight="Bold" FontSize="12" Margin="10,6,10,2" />

        <!-- Top 5 orders list -->
        <Border x:Name="ListingsBorder" Grid.Row="3" Background="#FF222222" CornerRadius="4" Margin="10,0,10,4" Padding="6,4" MinHeight="80">
            <Grid x:Name="TopOrdersPanel" HorizontalAlignment="Stretch" />
        </Border>

        <!-- Price per unit + Confirm -->
        <Grid Grid.Row="4" Margin="10,6,10,0" ColumnDefinitions="Auto,*">
            <StackPanel Spacing="4">
                <TextBlock Text="Price" Foreground="#FFB1D0D9" FontSize="12" />
                <Border Background="#FF2A2A2A" BorderBrush="#FF444444" BorderThickness="1"
                        CornerRadius="0" Width="110" HorizontalAlignment="Left">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox x:Name="PriceBox" Background="Transparent"
                                 Foreground="#FFB1D0D9" Padding="8,4" FontSize="12"
                                 VerticalContentAlignment="Center"
                                 BorderThickness="0"
                                 TextChanged="NumberBox_TextChanged" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0" HorizontalAlignment="Right">
                            <RepeatButton Classes="spin" Click="PricePlus_Click" Interval="30" Delay="150"
                                          Width="14" Height="15" Padding="0" Background="#FF333333"
                                          BorderBrush="#FF555555" BorderThickness="1" CornerRadius="1">
                                <Path Data="M 0,6 L 5,0 L 10,6 Z" Fill="#FFB1D0D9" Stretch="Uniform"
                                      Width="9" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </RepeatButton>
                            <RepeatButton Classes="spin" Click="PriceMinus_Click" Interval="30" Delay="150"
                                          Width="14" Height="15" Padding="0" Background="#FF333333"
                                          BorderBrush="#FF555555" BorderThickness="1" CornerRadius="1">
                                <Path Data="M 0,0 L 5,6 L 10,0 Z" Fill="#FFB1D0D9" Stretch="Uniform"
                                      Width="9" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </RepeatButton>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
            <Button x:Name="ConfirmButton" Grid.Column="1" Content="Confirm Listing" Click="Confirm_Click"
                    Background="#FF2D5A2D" Foreground="#FFB1D0D9" Padding="16,6"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    FontWeight="Bold" />
        </Grid>

        <!-- Status -->
        <TextBlock x:Name="ErrorText" Grid.Row="5" Margin="10,2,10,2"
                   FontSize="11" Foreground="#FF888888" />

        <!-- Navigation -->
        <Grid Grid.Row="6" Margin="10,4,10,4" ColumnDefinitions="Auto,Auto,*,Auto">
            <Button x:Name="BackButton" Content="Back" Click="Back_Click"
                    Background="#FF333333" Foreground="#FFB1D0D9" Padding="12,4" />
            <Button x:Name="CancelButton" Grid.Column="1" Content="Skip" Click="Cancel_Click"
                    Background="#FF5A2D2D" Foreground="#FFB1D0D9" Padding="12,4" Margin="4,0,0,0" />
            <TextBlock x:Name="PageText" Grid.Column="2" Text="1 / 1" Foreground="#FF888888"
                       FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Button x:Name="NextButton" Grid.Column="3" Content="Next" Click="Next_Click"
                    Background="#FF333333" Foreground="#FFB1D0D9" Padding="12,4" />
        </Grid>
    </Grid>
    </Border>
</Window>