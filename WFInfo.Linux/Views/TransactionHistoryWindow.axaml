<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WFInfo.Linux.Views.TransactionHistoryWindow"
        Title="Transaction History" Width="560"
        Height="480" MinWidth="500" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        Background="#FF1B1B1B">

    <Window.Styles>
        <Style Selector="Button.deleteBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFA52F31" />
            <Setter Property="BorderBrush" Value="#40A52F31" />
        </Style>
        <Style Selector="Button.deleteBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#20FF6969" />
            <Setter Property="Foreground" Value="#FFFF6969" />
            <Setter Property="BorderBrush" Value="#80FF6969" />
        </Style>
    </Window.Styles>

    <Border BorderBrush="#FF707070" BorderThickness="1">
    <Grid RowDefinitions="23,Auto,*" PointerPressed="OnPointerPressed">
        <!-- Title bar -->
        <Grid Grid.Row="0">
            <Rectangle Fill="#FF0F0F0F" />
            <Image Margin="2,0,0,0" Source="avares://WFInfo.Linux/Resources/WFLogo.png"
                   Height="20" VerticalAlignment="Center" HorizontalAlignment="Left" Width="18" />
            <TextBlock Text="Transaction History" Margin="24,1,0,0" FontSize="14" FontWeight="Bold"
                       FontFamily="{StaticResource RobotoBlack}"
                       VerticalAlignment="Center" />

            <Button Content="x" Click="Close_Click" Classes="linkButton"
                    Height="22" HorizontalAlignment="Right" Width="22"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
            <Rectangle Height="1" Fill="#FF646464" VerticalAlignment="Bottom" />
        </Grid>

        <!-- Income and Expenses summary -->
        <StackPanel Grid.Row="1" Margin="8,6,8,4">
            <Grid ColumnDefinitions="*,Auto" Margin="2,0,0,6">
                <TextBlock Text="Income and Expenses" FontWeight="Bold" FontSize="15"
                           Foreground="#FFB1D0D9" VerticalAlignment="Center" />
                <Button x:Name="RefreshBtn" Grid.Column="1" Content="Refresh" Click="Refresh_Click"
                        Background="#FF333333" Foreground="#FFB1D0D9" Padding="10,2"
                        BorderBrush="#FF555555" BorderThickness="1" />
            </Grid>
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
                <Border Grid.Column="0" Background="#FF222222" CornerRadius="4" Padding="8,6">
                    <StackPanel>
                        <TextBlock Text="Platinum received" Foreground="#FF888888" FontSize="11" />
                        <TextBlock x:Name="PlatReceived" Text="0" Foreground="#FF4CAF50" FontSize="18" FontWeight="Bold" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#FF222222" CornerRadius="4" Padding="8,6">
                    <StackPanel>
                        <TextBlock Text="Platinum spent" Foreground="#FF888888" FontSize="11" />
                        <TextBlock x:Name="PlatSpent" Text="0" Foreground="#FF4CAF50" FontSize="18" FontWeight="Bold" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#FF222222" CornerRadius="4" Padding="8,6">
                    <StackPanel>
                        <TextBlock Text="Items sold" Foreground="#FF888888" FontSize="11" />
                        <TextBlock x:Name="ItemsSold" Text="0" Foreground="#FF4CAF50" FontSize="18" FontWeight="Bold" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Background="#FF222222" CornerRadius="4" Padding="8,6">
                    <StackPanel>
                        <TextBlock Text="Items bought" Foreground="#FF888888" FontSize="11" />
                        <TextBlock x:Name="ItemsBought" Text="0" Foreground="#FF4CAF50" FontSize="18" FontWeight="Bold" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

        <!-- Transaction list -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="TransactionList" Margin="8,0,8,8" />
        </ScrollViewer>

        <!-- Loading overlay -->
        <Border x:Name="LoadingOverlay" Grid.Row="2" Background="#CC1B1B1B" IsVisible="True">
            <TextBlock Text="Loading transactions..." Foreground="#FFB1D0D9" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Grid>
    </Border>
</Window>