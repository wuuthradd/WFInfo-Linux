<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WFInfo.Linux.Views"
        x:Class="WFInfo.Linux.Views.RelicsWindow"
        Title="Relics" Height="500" Width="560"
        CanResize="True"
        SystemDecorations="None"
        Background="#FF1B1B1B"
        WindowStartupLocation="CenterScreen"
        MinHeight="300" MinWidth="560">

    <Window.Styles>
        <!-- Compact TextBox for toolbar strips -->
        <Style Selector="TextBox.strip">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Foreground" Value="#FFB1D0D9" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.strip /template/ Border#PART_BorderElement">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.strip:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.strip:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <!-- Compact CheckBox for toolbar strips -->
        <Style Selector="CheckBox.strip">
            <Setter Property="RenderTransform" Value="scale(0.85)" />
            <Setter Property="RenderTransformOrigin" Value="0%,50%" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="6,0,0,0" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <!-- Compact ComboBox for toolbar strips -->
        <Style Selector="ComboBox.strip">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ComboBox.strip /template/ Border#Background">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="#FF0F0F0F" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,0,0,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ComboBox.strip:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="#FF1B1B1B" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ComboBox.strip:pressed /template/ Border#Background">
            <Setter Property="Background" Value="#FF0F0F0F" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Styles>

    <Border BorderBrush="#FF707070" BorderThickness="1">
    <Grid PointerPressed="OnPointerPressed" RowDefinitions="23,27,27,*">
        <Rectangle Grid.Row="0" Fill="#FF0F0F0F" />
        <Image Grid.Row="0" Margin="2,0,0,0" Source="avares://WFInfo.Linux/Resources/WFLogo.png"
               Height="20" VerticalAlignment="Center" HorizontalAlignment="Left" Width="20" />
        <TextBlock Grid.Row="0" Text="Relics" Margin="28,1,0,0" FontSize="14" FontWeight="Bold"
                   FontFamily="{StaticResource RobotoBlack}"
                   VerticalAlignment="Center" />
        <Rectangle Grid.Row="0" Fill="#FF646464" Width="1" Margin="0,0,22,0" Height="22" VerticalAlignment="Top" HorizontalAlignment="Right" />
        <Button Grid.Row="0" Content="x" Click="Close_Click" Classes="linkButton"
                Height="22" HorizontalAlignment="Right" Width="22"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        <Rectangle Grid.Row="0" Height="1" Fill="#FF646464" VerticalAlignment="Bottom" />

        <!-- Filter row: expand/collapse, hide vaulted, filter label, search -->
        <Grid Grid.Row="1">
            <Rectangle Fill="#FF1B1B1B" />
            <Rectangle Height="1" Fill="#FF646464" VerticalAlignment="Bottom" />
            <DockPanel>
                <Button Content="＋" Click="ExpandAll_Click" ToolTip.Tip="Expand All"
                        Width="27" Height="27" FontSize="14"
                        Background="Transparent" Foreground="#FFB1D0D9" Padding="0"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        DockPanel.Dock="Left" />
                <Rectangle Fill="#FF646464" Width="1" DockPanel.Dock="Left" />
                <Button Content="－" Click="CollapseAll_Click" ToolTip.Tip="Collapse All"
                        Width="27" Height="27" FontSize="14"
                        Background="Transparent" Foreground="#FFB1D0D9" Padding="0"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        DockPanel.Dock="Left" />
                <Rectangle Fill="#FF646464" Width="1" DockPanel.Dock="Left" />
                <CheckBox x:Name="VaultedCheckBox" Content="Hide Vaulted" Classes="strip"
                          IsChecked="True" Margin="12,-4,6,0"
                          Click="VaultedClick" VerticalAlignment="Center"
                          ToolTip.Tip="Hide vaulted items."
                          DockPanel.Dock="Left" />
                <Rectangle Fill="#FF646464" Width="1" DockPanel.Dock="Left" />
                <TextBlock Text="Filter:" Padding="5,0" VerticalAlignment="Center" FontSize="13"
                           DockPanel.Dock="Left" />
                <Rectangle Fill="#FF646464" Width="1" DockPanel.Dock="Left" />
                <TextBox x:Name="SearchBox" Classes="strip" Watermark="Filter terms" FontSize="13"
                         TextChanged="SearchBox_TextChanged" />
            </DockPanel>
        </Grid>

        <!-- Sort row: era toggle, sort by label, combobox -->
        <Grid Grid.Row="2">
            <Rectangle Fill="#FF0F0F0F" />
            <DockPanel>
                <Button x:Name="AllRelicsButton" Content="Relic Eras" Click="ToggleAllRelics"
                        Width="80" Height="27" FontSize="13"
                        Background="Transparent" Foreground="#FFB1D0D9" Padding="0"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        DockPanel.Dock="Left" />
                <Rectangle Fill="#FF646464" Width="1" DockPanel.Dock="Left" />
                <TextBlock Text="Sort by:" Padding="5,0" VerticalAlignment="Center" FontSize="13"
                           DockPanel.Dock="Left" />
                <Rectangle Fill="#FF646464" Width="1" DockPanel.Dock="Left" />
                <ComboBox x:Name="SortBox" Classes="strip" SelectedIndex="0" Height="27"
                          FontSize="13" SelectionChanged="SortBoxChanged"
                          Foreground="#FFB1D0D9">
                    <ComboBoxItem Content="Name" />
                    <ComboBoxItem Content="Average intact plat" />
                    <ComboBoxItem Content="Average radiant plat" />
                    <ComboBoxItem Content="Difference (radiant-intact)" />
                </ComboBox>
            </DockPanel>
        </Grid>

        <!-- Virtualized flat list (replaces TreeView for performance) -->
        <Rectangle Grid.Row="3" Height="1" Fill="#FF646464" VerticalAlignment="Top" />
        <ListBox x:Name="RelicTree" Grid.Row="3" Margin="1,1,1,1"
                 Background="#FF1B1B1B"
                 SelectionMode="Single"
                 SelectionChanged="SingleClickExpand">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="FontFamily" Value="{StaticResource RobotoMono}" />
                </Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{Binding Background_Color}"
                            Padding="{Binding Depth, Converter={x:Static local:DepthToPaddingConverter.Instance}}">
                        <Grid ColumnDefinitions="16,*,110,155">
                            <TextBlock Grid.Column="0" Text="{Binding ExpandIndicator}"
                                       FontSize="12" Foreground="#FFB1D0D9"
                                       VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Grid.Column="1">
                                <TextBlock Text="{Binding Name}" FontSize="14"
                                           Foreground="{Binding NameColorHex}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Vaulted}" FontSize="12"
                                           Foreground="#506464" Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Col 1: INT: value [plat_icon] -->
                            <Grid Grid.Column="2" Margin="4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Col1_Text1}" FontSize="13"
                                           Foreground="{Binding NameColorHex}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Col1_Text2}" FontSize="13"
                                           Foreground="{Binding NameColorHex}" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" />
                                <Image Grid.Column="3" Width="16" Margin="3,0,0,0" HorizontalAlignment="Right"
                                       Source="avares://WFInfo.Linux/Resources/plat.png"
                                       IsVisible="{Binding IsCol1Img1Visible}" />
                            </Grid>

                            <!-- Col 2: RAD: value (bonus) [icon] -->
                            <Grid Grid.Column="3" Margin="4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Col2_Text1}" FontSize="13"
                                           Foreground="{Binding NameColorHex}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Col2_Text2}" FontSize="13"
                                           Foreground="{Binding NameColorHex}" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="{Binding Col2_Text3}" FontSize="13"
                                           Foreground="{Binding NameColorHex}" VerticalAlignment="Center"
                                           Margin="4,0,0,0" />
                                <Image Grid.Column="4" Width="16" Margin="3,0,0,0" HorizontalAlignment="Right"
                                       Source="avares://WFInfo.Linux/Resources/plat.png"
                                       IsVisible="{Binding IsCol2PlatVisible}" />
                                <Image Grid.Column="4" Width="16" Margin="3,0,0,0" HorizontalAlignment="Right"
                                       Source="avares://WFInfo.Linux/Resources/ducat_w.png"
                                       IsVisible="{Binding IsCol2DucatVisible}" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <!-- Resize grip (bottom-right) -->
        <Panel Grid.Row="3" HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Width="14" Height="14" Margin="0,0,1,1" Cursor="BottomRightCorner"
               PointerPressed="ResizeGrip_PointerPressed" Background="Transparent">
            <Path Stroke="White" StrokeThickness="1.5"
                  Data="M 4,14 L 14,4 M 8,14 L 14,8 M 12,14 L 14,12"/>
        </Panel>
    </Grid>
    </Border>
</Window>
