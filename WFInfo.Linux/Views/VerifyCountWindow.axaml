<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WFInfo.Linux.Views.VerifyCountWindow"
        Title="WFInfo - Verify Count" Height="150" Width="280"
        CanResize="False"
        SystemDecorations="None"
        Background="#FF1B1B1B"
        WindowStartupLocation="CenterScreen"
        Topmost="True">

    <Border BorderBrush="#FF707070" BorderThickness="1">
    <Grid PointerPressed="OnPointerPressed">
        <!-- Title bar -->
        <Rectangle Fill="#FF0F0F0F" Stroke="#FF646464" Height="25" VerticalAlignment="Top" />
        <Rectangle Stroke="#FF646464" />
        <TextBlock Text="WFInfo" Margin="26,3,0,0" FontSize="16" FontWeight="Bold"
                   FontFamily="{StaticResource RobotoBlack}"
                   VerticalAlignment="Top" HorizontalAlignment="Left" />

        <TextBlock Text="Please verify item counts" FontSize="18"
                   HorizontalAlignment="Center" Margin="0,28,0,0" VerticalAlignment="Top" />

        <Button x:Name="BackupButton" Content="Backup and clear inventory"
                HorizontalAlignment="Center" Margin="0,60,0,0" VerticalAlignment="Top"
                Height="35" Background="#FF0F0F0F" Foreground="#FFB1D0D9"
                Click="BackupClick" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                    VerticalAlignment="Bottom" Margin="0,0,0,15" Spacing="20">
            <Button Content="Save Count" Width="110" Height="35"
                    Background="#FF0F0F0F" Foreground="#FFB1D0D9" Click="SaveClick" />
            <Button Content="Cancel" Width="110" Height="35"
                    Background="#FF0F0F0F" Foreground="#FFB1D0D9" Click="CancelClick" />
        </StackPanel>
    </Grid>
    </Border>
</Window>